{
    "name": "nillm",
    "version": "1.2.0",
    "description": "NiLLM Arena App",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "pnpm typecheck && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "tauri:dev": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
        "prepare": "husky",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "format": "prettier --write .",
        "bump": "node scripts/bump-version.js",
        "update:providers": "node scripts/update-provider-presets.mjs",
        "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit && node node_modules/typescript-native/bin/tsc -p tsconfig.node.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "check": "pnpm typecheck && pnpm lint && pnpm test",
        "format:check": "prettier --check ."
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.91",
        "@ai-sdk/google": "^4.0.107",
        "@ai-sdk/openai": "^4.0.104",
        "@ai-sdk/openai-compatible": "^3.0.80",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@saurl/tauri-plugin-safe-area-insets-css-api": "^0.1.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-virtual": "^3.14.23",
        "@tauri-apps/api": "2.12.4",
        "@tauri-apps/plugin-dialog": "~2.8.4",
        "@tauri-apps/plugin-fs": "~2.7.1",
        "@tauri-apps/plugin-http": "^2.8.3",
        "@tauri-apps/plugin-process": "^2.4.0",
        "ai": "^7.0.156",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "decode-named-character-reference": "1.3.0",
        "hast-util-to-jsx-runtime": "2.3.6",
        "lucide-react": "^1.64.0",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-error-boundary": "^6.1.6",
        "react-markdown": "^10.1.0",
        "react-router": "^8.5.1",
        "recharts": "^3.10.1",
        "remark-gfm": "^4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "tailwind-merge": "^3.7.0",
        "unified": "11.0.5",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@tauri-apps/cli": "2.12.4",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/hast": "3.0.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "fake-indexeddb": "^6.2.6",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "typescript-native": "npm:typescript@^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11.0.0"
    },
    "packageManager": "pnpm@11.24.0"
}
